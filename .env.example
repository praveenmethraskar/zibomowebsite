# Zibomo website — mail settings (TEMPLATE).
#
# Copy this file to .env and fill it in. .env is gitignored and blocked from
# the web by .htaccess; never commit it or share it. Real environment
# variables override these, and these override includes/config.php.

# 'mail' = PHP mail() first, Gmail only when mail() fails (always on XAMPP).
# 'smtp' = always send through Gmail.
ZIBOMO_MAIL_TRANSPORT=mail

# Where the brochure and contact form emails go.
ZIBOMO_LEAD_RECIPIENT=support@zibomo.in

# Gmail account used when mail() cannot send. The password is a Google
# App Password (Google Account → Security → App passwords), not the
# account's normal password.
ZIBOMO_SMTP_HOST=smtp.gmail.com
ZIBOMO_SMTP_PORT=465
ZIBOMO_SMTP_ENCRYPTION=ssl
ZIBOMO_SMTP_USERNAME=zibomodigilocker@gmail.com
ZIBOMO_SMTP_PASSWORD=
