# Defence in depth: no PDF under assets/ is directly fetchable, in case a
# brochure copy is ever placed here by mistake. Images, video and CSS are
# unaffected.
<FilesMatch "\.(?i:pdf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
